logging {
	level  = "info"
	format = "logfmt"
}

// 고정 역할/작업의 숫자 지표만 읽는다. 호스트 proc/root는 마운트하지 않는다.
prometheus.exporter.unix "host_jobs" {
	set_collectors = ["textfile"]
	textfile {
		directory = "/var/lib/sugang-helper-host-jobs"
	}
}



discovery.docker "containers" {
	host             = "http://docker-log-proxy:2375"
	refresh_interval = "5s"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// 배포 스크립트의 Compose 프로젝트에 속한 로그만 수집한다.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex = "sugang-helper"
		action = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "job"
	}
}

loki.source.docker "containers" {
	host             = "http://docker-log-proxy:2375"
	targets          = discovery.relabel.containers.output
	labels           = {app = "jbnu-sugang-helper"}
	refresh_interval = "5s"
	forward_to       = [loki.process.docker.receiver]
}

loki.process "docker" {
	stage.docker { }
	stage.match {
		selector = "{job=\"app\"}"
		stage.multiline {
			firstline = "^(\\{|\\d{4}-\\d{2}-\\d{2})"
		}
	}
	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
