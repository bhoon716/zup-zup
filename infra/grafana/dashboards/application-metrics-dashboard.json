      "title": "HikariCP Connection Pool Status",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "id": 14,
      "targets": [
        { "expr": "hikaricp_connections_acquire_seconds_avg * 1000", "legendFormat": "Avg Acquire Time", "refId": "A" },
        { "expr": "hikaricp_connections_acquire_seconds_max * 1000", "legendFormat": "Max Acquire Time", "refId": "B" }
