      "targets": [
        {
          "refId": "A",
          "expr": "(((sum(increase(http_server_requests_seconds_sum{job=\"sugang-helper-app\"}[$__range]))) / (sum(increase(http_server_requests_seconds_count{job=\"sugang-helper-app\"}[$__range])))) * 1000) and on () (sum(increase(http_server_requests_seconds_count{job=\"sugang-helper-app\"}[$__range])) > 0)",
