      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (status)", "legendFormat": "HTTP {{status}}", "refId": "A" }],
      "title": "Requests per Second (by Status)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "id": 8,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "Latency Percentiles (p50, p95, p99)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "id": 9,
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..\"}[1m]))", "legendFormat": "4xx Errors", "refId": "A" },
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "5xx Errors", "refId": "B" }
      ],
      "title": "HTTP Error Rates (4xx / 5xx)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "title": "☕ JVM Memory, GC & Thread Telemetry",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 },
      "id": 10,
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "Heap Used", "refId": "A" },
        { "expr": "sum(jvm_memory_committed_bytes{area=\"heap\"})", "legendFormat": "Heap Committed", "refId": "B" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "Heap Max", "refId": "C" }
      ],
      "title": "JVM Heap Memory",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 },
      "id": 11,
      "targets": [
        { "expr": "sum(rate(jvm_gc_pause_seconds_sum[5m]))", "legendFormat": "GC Pause Time/s", "refId": "A" }
      ],
      "title": "JVM GC Pause Duration",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "id": 12,
      "targets": [
        { "expr": "jvm_threads_live_threads", "legendFormat": "Live Threads", "refId": "A" },
        { "expr": "jvm_threads_daemon_threads", "legendFormat": "Daemon Threads", "refId": "B" },
        { "expr": "jvm_threads_peak_threads", "legendFormat": "Peak Threads", "refId": "C" }
      ],
      "title": "JVM Thread Count",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "title": "🗄️ Database & HikariCP Pool Monitoring",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "id": 13,
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "Active", "refId": "A" },
        { "expr": "hikaricp_connections_idle", "legendFormat": "Idle", "refId": "B" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "Pending", "refId": "C" },
        { "expr": "hikaricp_connections_max", "legendFormat": "Max Limit", "refId": "D" }
