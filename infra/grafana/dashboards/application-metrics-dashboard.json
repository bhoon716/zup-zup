          "legendFormat": "p50",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": "Prometheus"
        },
        {
          "refId": "E",
          "expr": "(histogram_quantile(0.95, sum by (le) (increase(http_server_requests_seconds_bucket{job=\"sugang-helper-app\"}[$__range]))) * 1000) and on () (sum(increase(http_server_requests_seconds_count{job=\"sugang-helper-app\"}[$__range])) > 0)",
