          "range": false,
          "datasource": "Prometheus"
        },
        {
          "refId": "C",
          "expr": "((max(max_over_time(http_server_requests_seconds_max{job=\"sugang-helper-app\"}[$__range])) > 0) * 1000) and on () (sum(increase(http_server_requests_seconds_count{job=\"sugang-helper-app\"}[$__range])) > 0)",
