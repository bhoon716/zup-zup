{
  "annotations": {
    "list": []
  },
  "description": "Comprehensive Log Viewer Dashboard for Loki Streams",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📊 Log Rate & Error Metrics",
      "type": "row"
    },
    {
      "datasource": "Loki",
      "fieldConfig": { "defaults": { "unit": "logs/s" } },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$job\"}[$__interval])) / $__interval_ms * 1000",
          "legendFormat": "Total Logs/s",
          "refId": "A"
        }
      ],
      "title": "Total Log Throughput",
      "type": "timeseries"
    },
    {
      "datasource": "Loki",
      "fieldConfig": { "defaults": { "unit": "logs/s" } },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$job\"} |~ \"(?i)(error|exception|panic|fatal)\" [$__interval])) / $__interval_ms * 1000",
          "legendFormat": "Error Logs/s",
          "refId": "A"
        }
      ],
      "title": "Error & Exception Log Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "📜 Live Log Stream",
      "type": "row"
    },
    {
      "datasource": "Loki",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 7 },
      "id": 3,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=~\"$job\"} |= \"$search\"",
          "refId": "A"
        }
      ],
      "title": "Log Explorer Console",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 102,
      "title": "🔎 Correlation ID Trace",
      "type": "row"
    },
    {
      "datasource": "Loki",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 28 },
      "id": 4,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=~\"$job\"} |= \"corr=$correlationId\"",
          "refId": "A"
        }
      ],
      "title": "Request Flow by Correlation ID",
      "type": "logs"
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["sugang-helper", "loki", "logs"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": "Loki",
        "definition": "label_values(job)",
        "hide": 0,
        "includeAll": true,
        "label": "Service (Job)",
        "multi": true,
        "name": "job",
        "query": "label_values(job)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "", "value": "" },
        "hide": 0,
        "label": "Correlation ID",
        "name": "correlationId",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      },
      {
        "current": { "selected": true, "text": "", "value": "" },
        "hide": 0,
        "label": "Search Filter",
        "name": "search",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"]
  },
  "title": "Application & Service Logs (Loki)",
  "uid": "sadlil-loki-apps-dashboard",
  "version": 15
}
