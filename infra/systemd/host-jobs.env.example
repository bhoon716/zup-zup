# Optional non-secret EnvironmentFile: /etc/sugang-helper/host-jobs.env
# This file is not a shell script. Never add passwords or tokens.
RELEASE_ROOT=/home/ubuntu/jbnu-sugang-helper
DOCKER_DATA_PATH=/var/lib/docker
# Fixed existing production off-host backup owner; never root.
HOST_EXPORT_USER=ubuntu
# For a different release root, also review service EnvironmentFile and ReadWritePaths.
# Storage thresholds: adjust ExecStart with an operator-owned systemd drop-in.
# DB credentials are inherited only by the backup service from the existing runtime .env.
