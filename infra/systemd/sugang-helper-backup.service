[Unit]
Description=Sugang helper database, audit and upload export
After=docker.service local-fs.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
# Reuse the existing runtime credential source. Do not copy credentials to a new file.
EnvironmentFile=/home/ubuntu/jbnu-sugang-helper/.env
Environment=RELEASE_ROOT=/home/ubuntu/jbnu-sugang-helper
Environment=DOCKER_DATA_PATH=/var/lib/docker
# Keep archive ownership aligned with the existing off-host rsync account.
Environment=HOST_EXPORT_USER=ubuntu
EnvironmentFile=-/etc/sugang-helper/host-jobs.env
ExecStart=/usr/bin/python3 ${RELEASE_ROOT}/scripts/run-host-job.py backup
StateDirectory=sugang-helper-host-jobs
StateDirectoryMode=0750
ReadWritePaths=/home/ubuntu/jbnu-sugang-helper/backups
UMask=0077
TimeoutStartSec=16min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sugang-helper-host-job
LogRateLimitIntervalSec=5min
LogRateLimitBurst=30
